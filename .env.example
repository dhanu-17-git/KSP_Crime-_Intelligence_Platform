# ==============================================================================
# Environment Configuration Template
# Duplicate this file to '.env' (or 'backend/.env') and configure your values.
# NEVER commit the active '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Target API URL for the React dashboard
VITE_API_BASE="http://localhost:8000/api/v1"

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME="KSP Crime Intelligence API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
API_PREFIX="/api/v1"
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173"]'

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL / SQLite Fallback)
# ------------------------------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="ksp_crime_intel"
POSTGRES_USER="your_postgres_user"
POSTGRES_PASSWORD="your_postgres_password"

# Optional: Direct database URL (supports PostgreSQL asyncpg or SQLite aiosqlite)
# If empty, automatically falls back to local SQLite 'ksp_crime_intel.db'
DATABASE_URL="postgresql+asyncpg://your_postgres_user:your_postgres_password@localhost:5432/ksp_crime_intel"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY="your-random-32-byte-secret-key-here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# AI Provider (Google Gemini)
# ------------------------------------------------------------------------------
# Set to 'gemini' for live AI synthesis, or 'none' for deterministic offline mock
AI_PROVIDER="none"
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL_NAME="gemini-flash-latest"
